# Alternative .htaccess for Hostinger
# If the main .htaccess doesn't work, try renaming this file to .htaccess

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # If you're in a subdirectory, set the base path here
    # Example: RewriteBase /myapp/
    RewriteBase /
    
    # Remove trailing slashes (optional)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]
    
    # Handle CodeIgniter routing
    # Skip if file exists
    RewriteCond %{REQUEST_FILENAME} !-f
    # Skip if directory exists
    RewriteCond %{REQUEST_FILENAME} !-d
    # Rewrite everything else to index.php
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

# Prevent directory listing
Options -Indexes

# Prevent access to sensitive files
<FilesMatch "\.(md|sql|log|ini|sh|inc|bak|config)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<Files "composer.*">
    Order allow,deny
    Deny from all
</Files>
